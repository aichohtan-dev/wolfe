limit_req_zone $remote_addr zone=wolfe_auth:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=wolfe_global_api:10m rate=120r/s;
limit_req_status 429;
gzip on;
gzip_types text/plain text/css application/javascript application/json image/svg+xml;
gzip_min_length 1024;

server {
  listen 80;
  server_name ${WOLFE_SERVER_NAME};
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name ${WOLFE_SERVER_NAME};
  root /usr/share/nginx/html;
  server_tokens off;
  index index.html;
  ssl_certificate /etc/nginx/certs/fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_timeout 1d;
  ssl_session_cache shared:SSL:10m;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  add_header X-Permitted-Cross-Domain-Policies "none" always;
  add_header Content-Security-Policy "default-src 'self'; object-src 'none'; img-src 'self' data: https:; style-src 'self'; style-src-attr 'unsafe-inline'; style-src-elem 'self'; script-src 'self' https://challenges.cloudflare.com; connect-src 'self' https://challenges.cloudflare.com; font-src 'self' data:; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
  add_header Cross-Origin-Opener-Policy "same-origin" always;
  add_header Cross-Origin-Resource-Policy "same-origin" always;

  location = /api/v1/customers/login { proxy_connect_timeout 5s; proxy_send_timeout 30s; proxy_read_timeout 30s; limit_req zone=wolfe_auth burst=10 nodelay; client_max_body_size 1m; proxy_pass http://api:8080; include /etc/nginx/proxy_params; }
  location = /api/v1/customers/register { proxy_connect_timeout 5s; proxy_send_timeout 30s; proxy_read_timeout 30s; limit_req zone=wolfe_auth burst=10 nodelay; client_max_body_size 1m; proxy_pass http://api:8080; include /etc/nginx/proxy_params; }
  location = /api/v1/customers/refresh { proxy_connect_timeout 5s; proxy_send_timeout 30s; proxy_read_timeout 30s; limit_req zone=wolfe_auth burst=20 nodelay; client_max_body_size 1m; proxy_pass http://api:8080; include /etc/nginx/proxy_params; }
  location ^~ /api/v1/admin/pdf-imports/ { client_max_body_size 50m; proxy_pass http://api:8080; include /etc/nginx/proxy_params; }
  location /api/ { client_max_body_size 1m; limit_req zone=wolfe_global_api burst=240 nodelay; proxy_connect_timeout 5s; proxy_send_timeout 30s; proxy_read_timeout 30s; proxy_pass http://api:8080; include /etc/nginx/proxy_params; }
  location = /sitemap.xml { proxy_pass http://api:8080/sitemap.xml; include /etc/nginx/proxy_params; }
  location = /robots.txt { proxy_pass http://api:8080/robots.txt; include /etc/nginx/proxy_params; }
  location /catalog/published/ { proxy_pass http://api:8080/catalog/published/; include /etc/nginx/proxy_params; expires 1d; add_header Cache-Control "public, max-age=86400, immutable" always; }
  location /assets/ { try_files $uri =404; expires 30d; add_header Cache-Control "public, max-age=2592000, immutable" always; }
  location / { try_files $uri $uri/ /index.html; }
}
