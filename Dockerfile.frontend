FROM node:22.23.2-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci --ignore-scripts
COPY . .
RUN npm run build

FROM nginx:1.31-alpine@sha256:df221db836e1754089190208cee7eeda94f233197056426eda74a43ab1abeac2
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf.template /etc/nginx/templates/default.conf.template
COPY ops/proxy_params /etc/nginx/proxy_params
COPY ops/nginx-entrypoint.sh /usr/local/bin/wolfe-nginx-entrypoint.sh
RUN chmod +x /usr/local/bin/wolfe-nginx-entrypoint.sh
ENTRYPOINT ["/usr/local/bin/wolfe-nginx-entrypoint.sh"]
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget --no-check-certificate -qO- https://127.0.0.1/ >/dev/null || exit 1
