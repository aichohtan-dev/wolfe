FROM node:26.10.0-alpine@sha256:0b36e8c136b94cd4fcf02188228e76c31ad5872eef3fec8cbd2eee500cfd9e80 AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci --ignore-scripts
COPY . .
RUN npm run build

FROM nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf.template /etc/nginx/templates/default.conf.template
COPY ops/proxy_params /etc/nginx/proxy_params
COPY ops/nginx-entrypoint.sh /usr/local/bin/wolfe-nginx-entrypoint.sh
RUN chmod +x /usr/local/bin/wolfe-nginx-entrypoint.sh
ENTRYPOINT ["/usr/local/bin/wolfe-nginx-entrypoint.sh"]
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget --no-check-certificate -qO- https://127.0.0.1/ >/dev/null || exit 1
