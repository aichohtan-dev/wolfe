#!/bin/sh
set -eu
BASE_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
MVN_VERSION=3.9.11
CACHE_DIR="${HOME}/.m2/wrapper/dists/apache-maven-${MVN_VERSION}"
MVN_HOME="${CACHE_DIR}/apache-maven-${MVN_VERSION}"
if [ ! -x "${MVN_HOME}/bin/mvn" ]; then
  mkdir -p "${CACHE_DIR}"
  ARCHIVE="${CACHE_DIR}/apache-maven-${MVN_VERSION}-bin.zip"
  if [ ! -f "${ARCHIVE}" ]; then
    command -v curl >/dev/null 2>&1 || { echo 'curl is required to bootstrap Maven.' >&2; exit 1; }
    echo "Downloading Apache Maven ${MVN_VERSION}..." >&2
    curl -fL --retry 3 -o "${ARCHIVE}.tmp" "https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/${MVN_VERSION}/apache-maven-${MVN_VERSION}-bin.zip"
    mv "${ARCHIVE}.tmp" "${ARCHIVE}"
  fi
  command -v sha512sum >/dev/null 2>&1 || { echo "sha512sum is required to verify Maven bootstrap." >&2; exit 1; }
  printf "%s  %s\n" "03e2d65d4483a3396980629f260e25cac0d8b6f7f2791e4dc20bc83f9514db8d0f05b0479e699a5f34679250c49c8e52e961262ded468a20de0be254d8207076" "${ARCHIVE}" | sha512sum -c - >/dev/null
  command -v unzip >/dev/null 2>&1 || { echo 'unzip is required to bootstrap Maven.' >&2; exit 1; }
  rm -rf "${MVN_HOME}"
  unzip -q "${ARCHIVE}" -d "${CACHE_DIR}"
fi
exec "${MVN_HOME}/bin/mvn" -f "${BASE_DIR}/pom.xml" "$@"
