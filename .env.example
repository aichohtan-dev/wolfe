# Frontend
VITE_API_URL=/api/v1

# Backend / database
DATABASE_URL=jdbc:postgresql://localhost:5432/wolfe
DATABASE_USERNAME=wolfe
DATABASE_PASSWORD=change-me
POSTGRES_DB=wolfe
POSTGRES_USER=wolfe
POSTGRES_PASSWORD=change-me
REDIS_URL=redis://redis:6379

# Required application secrets / deployment config
WOLFE_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
WOLFE_JWT_TTL_SECONDS=900
WOLFE_FRONTEND_ORIGIN=http://localhost

# Set true only when API documentation should be exposed (normally false in production).
WOLFE_OPENAPI_ENABLED=false
