# ==============================================================================
# WOLFE RUNTIME CONFIGURATION TEMPLATE (.env.example)
# Note: Never insert production secrets or credentials directly into version control.
# ==============================================================================

# --- Frontend Networking ---
VITE_API_URL=/api/v1
WOLFE_PUBLIC_BASE_URL=http://localhost

# --- Database (PostgreSQL) Configuration ---
DATABASE_URL=jdbc:postgresql://localhost:5432/wolfe
DATABASE_USERNAME=wolfe
DATABASE_PASSWORD=change-me-to-a-secure-database-password
POSTGRES_DB=wolfe
POSTGRES_USER=wolfe
POSTGRES_PASSWORD=change-me-to-a-secure-database-password
POSTGRES_IMAGE=postgres:16-alpine@sha256:REPLACE_WITH_VERIFIED_DIGEST

# Database Pool & Timeout Settings
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT_MS=5000
DB_VALIDATION_TIMEOUT_MS=3000
DB_IDLE_TIMEOUT_MS=600000
DB_MAX_LIFETIME_MS=1800000
DB_STATEMENT_TIMEOUT_MS=30000

# --- Redis & Session Store Configuration ---
REDIS_URL=redis://localhost:6379
REDIS_USERNAME=wolfe
REDIS_PASSWORD=change-me-to-a-random-strong-redis-password
REDIS_IMAGE=redis:7-alpine@sha256:REPLACE_WITH_VERIFIED_DIGEST

# --- Application Security & JWT Tokens ---
WOLFE_JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_PLUS_CHAR_SECRET_FOR_HMAC_SHA256
WOLFE_JWT_TTL_SECONDS=900
WOLFE_JWT_ISSUER=wolfe-api
WOLFE_JWT_AUDIENCE=wolfe-web
WOLFE_JWT_KID=primary
WOLFE_JWT_KEYS=

# Session concurrency limits
WOLFE_MAX_SESSIONS=5
WOLFE_CONFIGURATION_TTL_DAYS=30

# --- CORS & Domain Isolation ---
WOLFE_FRONTEND_ORIGINS=http://localhost:5173
WOLFE_FRONTEND_ORIGIN=http://localhost

# --- Cookies, CSRF & Transport Security ---
# Authentication cookie transport (keep true in production; false only for local HTTP development)
WOLFE_SECURE_COOKIES=true
WOLFE_COOKIE_SAMESITE=Lax
WOLFE_COOKIE_DOMAIN=

# --- Request & Async Timeouts ---
WOLFE_ASYNC_REQUEST_TIMEOUT_MS=30000

# --- API Documentation & Observability ---
# Set true only when API documentation should be exposed (normally false in production).
WOLFE_OPENAPI_ENABLED=false
WOLFE_TRACING_SAMPLE_RATE=0.1
WOLFE_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# --- Mock Email & Third-Party Integration Placeholders (Local / Test Mode) ---
WOLFE_MAIL_HOST=localhost
WOLFE_MAIL_PORT=1025
WOLFE_MAIL_FROM=noreply@wolfe.local
WOLFE_PAYMENT_GATEWAY_MODE=TEST_MOCK

