{
  "name": "wolfe-storefront",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender-seo.mjs && node scripts/bundle-size-check.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:contract": "node --test scripts/frontend-contract.test.mjs",
    "test:unit": "node --test src/unit/basic.test.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "lint": "npm run typecheck"
  },
  "dependencies": {
    "lucide-react": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.6.1",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.17",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}
