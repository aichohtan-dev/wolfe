{
  "name": "wolfe-storefront",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender-seo.mjs && node scripts/bundle-size-check.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:contract": "node --test scripts/frontend-contract.test.mjs",
    "test:unit": "node --test src/unit/basic.test.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "lint": "npm run typecheck"
  },
  "dependencies": {
    "lucide-react": "0.511.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "vite": "6.4.3"
  }
}
